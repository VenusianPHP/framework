{
    "name": "venusian/framework",
    "description": "The Venusian PHP Framework.",
    "keywords": [
        "framework",
        "venusian",
        "scrapyard-io"
    ],
    "license": "MIT",
    "version": "0.10.4",
    "support": {
        "issues": "https://github.com/VenusianPHP/framework/issues",
        "source": "https://github.com/VenusianPHP/framework"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ramsey/uuid": "^4.7",
        "symfony/uid": "^8.0.0",
        "symfony/finder": "^8.0",
        "monolog/monolog": "^3.0",
        "symfony/mime": "^v8.0.0",
        "nesbot/carbon": "^3.8.4",
        "laravel/prompts": "^0.3.15",
        "symfony/console": "^8.0.0",
        "symfony/process": "^8.0.0",
        "psr/log": "^1.0|^2.0|^3.0",
        "vlucas/phpdotenv": "^5.6.1",
        "doctrine/inflector": "^2.0",
        "nunomaduro/termwind": "^2.0",
        "league/flysystem": "^3.25.1",
        "league/commonmark": "^2.8.1",
        "symfony/var-dumper": "^8.0.0",
        "guzzlehttp/promises": "^2.0",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/uri-template": "^1.0",
        "symfony/filesystem": "^v8.0.0",
        "voku/portable-ascii": "^2.0.2",
        "symfony/error-handler": "^8.0.0",
        "symfony/polyfill-php84": "^1.33",
        "symfony/polyfill-php85": "^1.33",
        "league/flysystem-local": "^3.25.1",
        "symfony/event-dispatcher": "^8.0.0",
        "laravel/serializable-closure": "^2.0",
        "brick/math": "^0.15|^0.16|^0.17|^0.18|^1.0",
        "guzzlehttp/psr7": "^2.7",
        "phpoption/phpoption": "^1.9",
        "psr/container": "^1.1.1 || ^2.0.1",
        "psr/http-message": "^1.1|^2.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
        "symfony/polyfill-php86": "^1.34"
    },
    "replace": {
        "venusian-voyager/broadcasting": "self.version",
        "venusian-voyager/bus": "self.version",
        "venusian-voyager/cache": "self.version",
        "venusian-voyager/collections": "self.version",
        "venusian-voyager/concurrency": "self.version",
        "venusian-voyager/conditionable": "self.version",
        "venusian-voyager/config": "self.version",
        "venusian-voyager/console": "self.version",
        "venusian-voyager/contracts": "self.version",
        "venusian-voyager/database": "self.version",
        "venusian-voyager/encryption": "self.version",
        "venusian-voyager/filesystem": "self.version",
        "venusian-voyager/graph": "self.version",
        "venusian-voyager/hashing": "self.version",
        "venusian-voyager/http": "self.version",
        "venusian-voyager/io-pools": "self.version",
        "venusian-voyager/log": "self.version",
        "venusian-voyager/macroable": "self.version",
        "venusian-voyager/nuts-and-bolts": "self.version",
        "venusian-voyager/pagination": "self.version",
        "venusian-voyager/pipeline": "self.version",
        "venusian-voyager/process": "self.version",
        "venusian-voyager/queue": "self.version",
        "venusian-voyager/redis": "self.version",
        "venusian-voyager/reflection": "self.version",
        "venusian-voyager/signals": "self.version",
        "venusian-voyager/sketches": "self.version",
        "venusian-voyager/vessel": "self.version",
        "venusian-voyager/workflows": "self.version"
    },
    "suggest": {
        "aws/aws-sdk-php": "Required to use the s3 driver (^3.322.9).",
        "ext-curl": "Required for the curl async driver.",
        "ext-fileinfo": "Required to detect the MIME type of local files.",
        "ext-intl": "Required to format numbers with Number.",
        "ext-parallel": "Required to use the thread worker-pool driver (ZTS builds only).",
        "ext-pcntl": "Required for signal handling: trapped command signals, queue worker timeouts, and loop stop signals.",
        "ext-pcurl": "Required for the pcurl async driver: curl's own sockets wait on the loop.",
        "ext-posix": "Required for a timed-out worker to kill itself.",
        "ext-redis": "Required to use the phpredis connector (^4.0|^5.0|^6.0).",
        "fakerphp/faker": "Required to use the Instrument factory builder (^1.24).",
        "laudis/neo4j-php-client": "Required for Voyager\\Graph Neo4j connections (^3.3).",
        "league/flysystem-aws-s3-v3": "Required to use the s3 driver (^3.25.1).",
        "league/flysystem-ftp": "Required to use the ftp driver (^3.25.1).",
        "league/flysystem-path-prefixing": "Required to use the prefix disk option (^3.25.1).",
        "league/flysystem-read-only": "Required to use the read-only disk option (^3.25.1).",
        "league/flysystem-sftp-v3": "Required to use the sftp driver (^3.25.1).",
        "php-io-extensions/epoll": "Required to use the epoll waiter backend on Linux.",
        "php-io-extensions/kqueue": "Required to use the kqueue waiter backend on macOS and BSD.",
        "predis/predis": "Required to use the predis connector (^2.3|^3.0).",
        "pusher/pusher-php-server": "Required to use the Pusher and Reverb broadcast drivers (^7.0).",
        "react/promise": "Required to use the react promise engine (^3.0).",
        "spatie/fork": "Required to use the fork concurrency driver (^1.2)."
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4"
    },
    "scripts": {},
    "autoload": {
        "psr-4": {
            "Voyager\\": "src/Voyager",
            "Voyager\\NutsAndBolts\\": [
                "src/Voyager/Macroable/",
                "src/Voyager/Collections/",
                "src/Voyager/Conditionable/",
                "src/Voyager/Reflection/"
            ]
        },
        "files": [
            "src/Voyager/Core/Helpers/helpers.php",
            "src/Voyager/Signals/Helpers/functions.php",
            "src/Voyager/Collections/Helpers/helpers.php",
            "src/Voyager/Collections/Helpers/functions.php",
            "src/Voyager/Reflection/Helpers/helpers.php",
            "src/Voyager/NutsAndBolts/Helpers/functions.php",
            "src/Voyager/NutsAndBolts/Helpers/helpers.php",
            "src/Voyager/NutsAndBolts/Helpers/time.php",
            "src/Voyager/Filesystem/functions.php",
            "src/Voyager/Filesystem/helpers.php",
            "src/Voyager/Graph/Helpers/functions.php",
            "src/Voyager/Broadcasting/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Venusian\\Tests\\": "tests/"
        },
        "files": []
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
