<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Test Suite">
            <directory suffix="Test.php">./tests</directory>
            <exclude>./tests/Queue/deferred</exclude>
            <exclude>./tests/Bus/deferred</exclude>
            <exclude>./tests/Log/deferred</exclude>
            <exclude>./tests/Redis/deferred</exclude>
            <exclude>./tests/Pipeline/deferred</exclude>
            <exclude>./tests/Database/deferred</exclude>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>deferred</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
