{
    "name": "venusian-voyager/magic-aliases",
    "description": "The Voyager MagicAliases package \u2014 the alias base class.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "venusian-voyager/contracts": "^0.8.0"
    },
    "suggest": {
        "mockery/mockery": "Required to use alias fakes (shouldReceive, spy, partialMock)."
    },
    "autoload": {
        "psr-4": {
            "Voyager\\MagicAliases\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.8.x-dev"
        },
        "venusian": {
            "upstream": "ScrapyardIO/framework",
            "upstream-ref": "0.7.x",
            "upstream-path": "src/Fabricate/MagicAliases",
            "ported-at": "2026-08-19",
            "note": "Base class only. The concrete aliases live in voyager/nuts-and-bolts, since they are framework-level rather than generic."
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
