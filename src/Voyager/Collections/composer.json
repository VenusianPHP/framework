{
    "name": "venusian-voyager/collections",
    "description": "The Voyager Collections package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "symfony/polyfill-php85": "^1.33",
        "symfony/polyfill-php86": "^1.34",
        "venusian-voyager/conditionable": "^0.10.0",
        "venusian-voyager/contracts": "^0.10.0",
        "venusian-voyager/macroable": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0"
    },
    "suggest": {
        "symfony/var-dumper": "Required for dd() and dump() (^8.0.0)."
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Voyager\\NutsAndBolts\\": ""
        },
        "files": [
            "Helpers/helpers.php",
            "Helpers/functions.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        }
    }
}
