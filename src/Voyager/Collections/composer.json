{
  "name": "venusian-voyager/collections",
  "description": "The Voyager Collections package.",
  "license": "MIT",
  "authors": [
    {
        "name": "Angel Gonzalez",
        "email": "angel@projectsaturnstudios.com"
    },
    {
        "name": "Taylor Otwell"
    }
  ],
  "require": {
      "php": "^8.4|^8.5",
      "symfony/polyfill-php84": "^1.33",
      "symfony/polyfill-php85": "^1.33",
      "venusian-voyager/macroable": "^0.9.0",
      "venusian-voyager/contracts": "^0.9.0",
      "venusian-voyager/conditionable": "^0.9.0"
  },
  "minimum-stability": "dev",
  "autoload": {
    "psr-4": {
        "Voyager\\NutsAndBolts\\": ""
    },
    "files": [
      "Helpers/helpers.php",
      "Helpers/functions.php"
    ]
  },
  "config": {
      "sort-packages": true
  },
  "extra": {
    "branch-alias": {
        "dev-main": "0.9.x-dev"
    }
  }
}