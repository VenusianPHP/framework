{
    "name": "venusian-voyager/database",
    "description": "The Voyager Database package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "ext-pdo": "*",
        "brick/math": "^0.13|^0.14|^0.15|^0.16|^0.17|^0.18",
        "laravel/serializable-closure": "^2.0",
        "symfony/polyfill-php83": "^1.33",
        "symfony/polyfill-php85": "^1.33",
        "venusian-voyager/collections": "^0.9.0",
        "venusian-voyager/contracts": "^0.9.0",
        "venusian-voyager/io-pools": "^0.9.0",
        "venusian-voyager/macroable": "^0.9.0",
        "venusian-voyager/nuts-and-bolts": "^0.9.0",
        "venusian-voyager/pagination": "^0.9.0",
        "venusian-voyager/vessel": "^0.9.0"
    },
    "suggest": {
        "ext-filter": "Required to use the Postgres database driver.",
        "fakerphp/faker": "Required to use the Instrument factory builder (^1.24).",
        "symfony/finder": "Required to use Instrument model factories (^7.2).",
        "venusian-voyager/console": "Required to use the database commands (^0.9.0).",
        "venusian-voyager/filesystem": "Required to use the migrations (^0.9.0).",
        "venusian-voyager/signals": "Required to use observers with Instrument (^0.9.0)."
    },
    "autoload": {
        "psr-4": {
            "Voyager\\Database\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.9.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
