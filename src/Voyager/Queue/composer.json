{
    "name": "venusian-voyager/queue",
    "description": "The Voyager Queue package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "laravel/serializable-closure": "^2.0",
        "ramsey/uuid": "^4.7",
        "symfony/process": "^7.2",
        "venusian-voyager/collections": "^0.9.0",
        "venusian-voyager/console": "^0.9.0",
        "venusian-voyager/contracts": "^0.9.0",
        "venusian-voyager/filesystem": "^0.9.0",
        "venusian-voyager/nuts-and-bolts": "^0.9.0",
        "venusian-voyager/pipeline": "^0.9.0",
        "venusian-voyager/vessel": "^0.9.0"
    },
    "suggest": {
        "venusian-voyager/database": "Required to use the database queue driver and the database failed-job providers (^0.9.0)."
    },
    "autoload": {
        "psr-4": {
            "Voyager\\Queue\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.9.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
