{
    "name": "venusian-voyager/broadcasting",
    "description": "The Voyager Broadcasting package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "psr/log": "^3.0",
        "venusian-voyager/bus": "^0.10.0",
        "venusian-voyager/collections": "^0.10.0",
        "venusian-voyager/contracts": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0",
        "venusian-voyager/queue": "^0.10.0",
        "venusian-voyager/vessel": "^0.10.0"
    },
    "suggest": {
        "ext-hash": "Required to use the Pusher broadcast driver.",
        "pusher/pusher-php-server": "Required to use the Pusher and Reverb broadcast drivers (^7.0).",
        "venusian-voyager/redis": "Required to use the redis broadcast driver (^0.10.0)."
    },
    "autoload": {
        "psr-4": {
            "Voyager\\Broadcasting\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
