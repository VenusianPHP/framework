{
    "name": "voyager/broadcasting",
    "description": "The Voyager Broadcasting package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "psr/log": "^3.0",
        "voyager/bus": "^0.8.0",
        "voyager/collections": "^0.8.0",
        "voyager/contracts": "^0.8.0",
        "voyager/nuts-and-bolts": "^0.8.0",
        "voyager/queue": "^0.8.0",
        "voyager/vessel": "^0.8.0"
    },
    "suggest": {
        "ext-hash": "Required to use the Pusher broadcast driver.",
        "pusher/pusher-php-server": "Required to use the Pusher broadcast driver (^7.0)."
    },
    "autoload": {
        "psr-4": {
            "Voyager\\Broadcasting\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.8.x-dev"
        },
        "venusian": {
            "upstream": "laravel/framework",
            "upstream-ref": "v12.67.0",
            "upstream-path": "src/Illuminate/Broadcasting",
            "ported-at": "2026-08-20"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
